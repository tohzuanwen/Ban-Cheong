<script>
  const searchInput = document.getElementById("productSearch");
  const clearSearch = document.querySelector(".clear-search");
  const searchResults = document.getElementById("searchResults");
  const noResults = document.getElementById("noResults");
  const categorySections = Array.from(document.querySelectorAll(".category-section"));
  const products = Array.from(document.querySelectorAll(".product"));

  products.forEach((product) => {
    const category = product.closest(".category-section").querySelector(".category-title").textContent;
    product.dataset.search = `${category} ${product.textContent}`.toLowerCase();
  });

  function filterProducts() {
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    products.forEach((product) => {
      const isMatch = product.dataset.search.includes(query);
      product.classList.toggle("is-hidden", query && !isMatch);

      if (!query || isMatch) {
        visibleCount += 1;
      }
    });

    categorySections.forEach((section) => {
      const hasVisibleProducts = section.querySelectorAll(".product:not(.is-hidden)").length > 0;
      section.classList.toggle("is-hidden", query && !hasVisibleProducts);
    });

    clearSearch.classList.toggle("is-visible", query.length > 0);
    noResults.classList.toggle("is-visible", query.length > 0 && visibleCount === 0);
    searchResults.textContent = query
      ? `${visibleCount} product${visibleCount === 1 ? "" : "s"} found`
      : "Showing all products";
  }

  searchInput.addEventListener("input", filterProducts);

  clearSearch.addEventListener("click", () => {
    searchInput.value = "";
    searchInput.focus();
    filterProducts();
  });

  const searchParams = new URLSearchParams(window.location.search);
  const homepageSearch = searchParams.get("search");

  if (homepageSearch) {
    searchInput.value = homepageSearch;
    filterProducts();
  }
</script>

